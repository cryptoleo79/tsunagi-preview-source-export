# Tsunagi preprod relay — installed from GitHub Release
[Unit]
Description=Tsunagi Preprod Relay
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/.local/tsunagi/current
ExecStart=%h/.local/tsunagi/current/bin/tsunagi-node run --net preprod --lang en

# === TSUNAGI ENVIRONMENT ===
Environment=TSUNAGI_HOME=%h/tsunagi-home-preprod
Environment=TSUNAGI_CAPTURE=1
Environment=TSUNAGI_METRICS=1
Environment=TSUNAGI_METRICS_ADDR=127.0.0.1
Environment=TSUNAGI_METRICS_PORT=9083
Environment=TSUNAGI_LMDB=%h/tsunagi-home-preprod/lmdb
Environment=TSUNAGI_LMDB_TRUTH=0
Environment=TSUNAGI_LMDB_AUTHORITY=0

# === RESTART ===
Restart=always
RestartSec=30

# === SECURITY ===
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=%h/.local/tsunagi
ReadWritePaths=%h/tsunagi-home-preprod
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true

[Install]
WantedBy=default.target

# Tsunagi fork readiness check — preview (daily)
[Unit]
Description=Tsunagi Fork Readiness Check (preview)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/tsunagi-follower
Environment=TSUNAGI_HOME=%h/tsunagi-home-preview
ExecStart=/usr/bin/python3 scripts/fork_readiness_check.py \
  --home %h/tsunagi-home-preview \
  --net preview \
  --bin %h/.local/tsunagi/current/bin/tsunagi-node \
  --state-url http://127.0.0.1:9081/state \
  --metrics-url http://127.0.0.1:9081/metrics

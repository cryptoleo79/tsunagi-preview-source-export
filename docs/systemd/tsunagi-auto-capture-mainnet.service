# Tsunagi auto vector capture — mainnet (nightly)
[Unit]
Description=Tsunagi Auto Vector Capture (mainnet)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/tsunagi-follower
Environment=TSUNAGI_HOME=%h/tsunagi-home-mainnet
ExecStart=/usr/bin/python3 scripts/auto_capture_vectors.py \
  --home %h/tsunagi-home-mainnet \
  --net mainnet \
  --max-new 50

# Tsunagi auto vector capture — preview (nightly)
[Unit]
Description=Tsunagi Auto Vector Capture (preview)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/tsunagi-follower
Environment=TSUNAGI_HOME=%h/tsunagi-home-preview
ExecStart=/usr/bin/python3 scripts/auto_capture_vectors.py \
  --home %h/tsunagi-home-preview \
  --net preview \
  --max-new 50

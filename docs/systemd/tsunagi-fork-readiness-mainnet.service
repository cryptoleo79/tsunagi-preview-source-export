# Tsunagi fork readiness check — mainnet (weekly)
[Unit]
Description=Tsunagi Fork Readiness Check (mainnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/tsunagi-follower
Environment=TSUNAGI_HOME=%h/tsunagi-home-mainnet
ExecStart=/usr/bin/python3 scripts/fork_readiness_check.py \
  --home %h/tsunagi-home-mainnet \
  --net mainnet \
  --bin %h/.local/tsunagi/current/bin/tsunagi-node \
  --state-url http://127.0.0.1:9080/state \
  --metrics-url http://127.0.0.1:9080/metrics

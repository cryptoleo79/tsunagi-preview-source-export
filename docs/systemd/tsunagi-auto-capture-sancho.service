# Tsunagi auto vector capture — sancho (nightly)
[Unit]
Description=Tsunagi Auto Vector Capture (sancho)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/tsunagi-follower
Environment=TSUNAGI_HOME=%h/tsunagi-home-sancho
ExecStart=/usr/bin/python3 scripts/auto_capture_vectors.py \
  --home %h/tsunagi-home-sancho \
  --net sancho \
  --max-new 50

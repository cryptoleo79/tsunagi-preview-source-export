cabal-version:      2.4
name:               praos-threshold-oracle
version:            0.1.0.0
synopsis:           Praos threshold oracle using cardano-node reference arithmetic
description:
  Computes the Praos leader threshold T = 1 - (1-f)^sigma exactly as
  cardano-node does, using 34-digit fixed-point arithmetic with continued
  fractions for ln and Taylor series for exp.
  .
  Outputs JSONL with non-null expected_threshold_x1e12 for use as the
  PASS/FAIL oracle in tsunagi-node praos-exact-align.
  .
  Arithmetic vendored from:
    https://github.com/IntersectMBO/cardano-ledger
    libs/non-integral/src/Cardano/Ledger/NonIntegral.hs
  .
  FixedPoint type (E34, 34 decimal digits) from:
    libs/cardano-ledger-core/src/Cardano/Ledger/BaseTypes.hs

license:            Apache-2.0
build-type:         Simple

executable praos-threshold-oracle
  main-is:          Main.hs
  other-modules:    NonIntegral
  hs-source-dirs:   .
  build-depends:    base >= 4.14 && < 5
  default-language: Haskell2010
  ghc-options:      -Wall -O2

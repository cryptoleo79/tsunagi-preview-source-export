# ─────────────────────────────────────────────────────────────────────────────
# TSUNAGI forge.env — operator template
# ─────────────────────────────────────────────────────────────────────────────
#
# Purpose:
#   Single source of truth for forge-side environment configuration.
#   Auto-loaded by the node from ${TSUNAGI_HOME}/forge.env at startup,
#   BEFORE any env var is read by the runtime. Each KEY=VALUE line is
#   injected via setenv(KEY, VALUE, /*overwrite=*/1), meaning:
#
#     - Values in this file OVERRIDE values inherited from the parent shell.
#     - Comments (# ...) and blank lines are ignored.
#     - Quotes are NOT stripped — write bare values, no surrounding "..." or '...'.
#     - One KEY=VALUE per line. No trailing spaces, no `export` prefix.
#
# Safety:
#   This is a TEMPLATE. Replace every <PLACEHOLDER> and /PATH/TO/... before use.
#   Never commit a populated forge.env to git. Permissions should be 0600.
#
# Mode collapse (PR #171 / #172 / #173):
#   The legacy preview/no-broadcast/policy/gate-enforce/dryrun knobs were
#   collapsed into a single TSUNAGI_MODE selector plus the explicit
#   TSUNAGI_FORGE_ENABLE / TSUNAGI_FORGE_REQUIRE_GUARDIAN_CONFIRM gates.
#   See the "Removed / deprecated" block at the bottom of this file.
#
# ─────────────────────────────────────────────────────────────────────────────


# ─── Required: runtime mode ─────────────────────────────────────────────────
# Single source of truth for forge / broadcast behavior.
#   preview_safe : forge runs locally, sealed artifact written to disk,
#                  PROPAGATION_SUPPRESSED at every send site — zero bytes
#                  leave the node. Default.
#   live         : forge runs, sealed artifact written, PROPAGATION_SEND
#                  fires on each emit, bytes go to the connected relay.
#
# Start with preview_safe. Switch to live only after a clean forge cycle
# is observed locally (FORGE_PROMOTE_ATOMIC + sealed artifact present).
TSUNAGI_MODE=preview_safe


# ─── Required: forge gate ───────────────────────────────────────────────────
# Master switch for block production. When 1, the producer thread is armed.
# When unset or 0, the node runs as follower-only (safe default).
TSUNAGI_FORGE_ENABLE=0

# Guardian confirmation gate. When 1, every forge attempt must clear the
# guardian preflight checklist. Required whenever TSUNAGI_FORGE_ENABLE=1.
TSUNAGI_FORGE_REQUIRE_GUARDIAN_CONFIRM=1


# ─── Required: forge keys ───────────────────────────────────────────────────
# VRF signing key (cardano-cli `node key-gen-VRF` skey). Bech32 or hex JSON
# accepted by the node loader. The path must be readable by the node user
# only (chmod 0400). Read by src/producer/vrf.zig.
TSUNAGI_VRF_SKEY_PATH=/PATH/TO/vrf.skey

# KES signing key (cardano-cli `node key-gen-KES` skey). Rotated each KES
# evolution boundary. Read by src/producer/kes.zig.
TSUNAGI_KES_SKEY_PATH=/PATH/TO/kes.skey

# Cold verification key (operator pool cold vkey, raw 32-byte ed25519 public
# key, hex-encoded, exactly 64 hex chars). Used as the opcert subject and
# embedded in the block header. Read by src/producer/producer.zig.
TSUNAGI_COLD_VK_HEX=<COLD_VK_HEX_64>

# Operational certificate signature: the cold-key signature over
# (kes_pk || opcert_seq || kes_period_start). 64 raw bytes hex-encoded =
# exactly 128 hex chars. Produced offline by the cold-key custodian.
TSUNAGI_OPCERT_SIGMA_HEX=<OPCERT_SIGMA_HEX_128>

# Pool id (Blake2b-224 hash of the cold vkey, hex-encoded, exactly 56 hex
# chars). Read by src/producer/keys.zig + src/cli/producer_bridge_cmd.zig.
TSUNAGI_POOL_ID_HEX=<POOL_ID_HEX_56>


# ─── Required: ledger store ─────────────────────────────────────────────────
# LMDB UTxO directory. Must be a real path — values "0" or "1" are rejected
# (legacy footgun). Canonical layout: ${TSUNAGI_HOME}/lmdb. Read across
# follower, kagami, guardian, snapshot, backfill, and digest tooling.
TSUNAGI_LMDB=${TSUNAGI_HOME}/lmdb


# ────────────────────────────────────────────────────────────────────────────
# Optional: defaults below are sensible. Override only when needed.
# ────────────────────────────────────────────────────────────────────────────

# ─── Optional: home + network resolution ────────────────────────────────────
# TSUNAGI_HOME — state directory. Resolution precedence is:
#   1. CLI / shell environment value (highest)
#   2. ${HOME}/tsunagi-home-<net>  (default, network-aware)
# When set here, this value wins over ${HOME}-based defaults.
#TSUNAGI_HOME=/var/lib/tsunagi

# TSUNAGI_NET — network selector. The CLI flag `--net <name>` always wins;
# this env var is the fallback when --net is not passed.
# Valid values: preview, preprod, mainnet.
#TSUNAGI_NET=preview


# ─── Optional: VRF / KES enable flags ───────────────────────────────────────
# Explicit enable gates for VRF and KES subsystems. Both default off; the
# `tsunagi-node vrf-selftest` command requires TSUNAGI_VRF_ENABLE=1.
# When TSUNAGI_FORGE_ENABLE=1, both should be 1.
#TSUNAGI_VRF_ENABLE=1
#TSUNAGI_KES_ENABLE=1


# ─── Optional: metrics endpoint ─────────────────────────────────────────────
# HTTP /metrics endpoint. Disabled by default unless --debug is passed.
#TSUNAGI_METRICS=1
#TSUNAGI_METRICS_ADDR=127.0.0.1
#TSUNAGI_METRICS_PORT=9080


# ─── Recommended: upstream peers ────────────────────────────────────────────
# Multi-peer following improves parent freshness, reduces stale-parent races,
# and is strongly recommended for production. All peer configuration is
# operator-driven via env vars — no peer addresses are embedded in the binary.
#
# TSUNAGI_PEER_PRIMARY (required for live forge):
#   The primary upstream relay. host:port. ChainSync + BlockFetch +
#   header_store updates flow from this peer; ctx.rx_* is updated
#   monotonically when block_no advances.
#
# TSUNAGI_PEER_SECONDARY (recommended, comma- or semicolon-separated):
#   One or more additional upstream relays observed in parallel via
#   header-only ChainSync probes (peer_probe.zig). Each probe runs in
#   a detached thread and feeds the same ctx.rx_* monotonically. If a
#   secondary sees a fresher tip than the primary, the forge gate uses
#   it as the parent at slot leader time.
#
#   Production guidance:
#     - Configure at least 2 secondaries on diverse network paths.
#     - Probes are cheap (header-only, no ledger, no block bodies).
#     - Cap is MAX_PROBES=8 in peer_probe.zig.
#
# Example:
#   TSUNAGI_PEER_PRIMARY=relay1.example.com:3001
#   TSUNAGI_PEER_SECONDARY=relay2.example.com:3001,relay3.example.com:30002
#TSUNAGI_PEER_PRIMARY=<RELAY_HOST>:<RELAY_PORT>
#TSUNAGI_PEER_SECONDARY=<RELAY2>:<PORT>,<RELAY3>:<PORT>


# ─── Optional: stake fraction fallback ──────────────────────────────────────
# Static stake fraction (sigma * 1e9, integer) used by the leader-eligibility
# model until the ledger-derived sigma path is wired up. Read by
# src/producer/leader_model.zig. Source value from Koios pool_info /
# pool_stake_snapshot. Set to 0 to disable the fallback once ledger sigma
# becomes authoritative.
#TSUNAGI_STAKE_FRACTION_X1E9=<STAKE_FRACTION_X1E9_FROM_KOIOS>


# ────────────────────────────────────────────────────────────────────────────
# Removed / deprecated — DO NOT SET
# ────────────────────────────────────────────────────────────────────────────
# The following variables were collapsed into TSUNAGI_MODE +
# TSUNAGI_FORGE_ENABLE + TSUNAGI_FORGE_REQUIRE_GUARDIAN_CONFIRM by
# PR #171 / #172 / #173 and are no longer consulted. Setting them has no
# effect and is treated as a configuration smell by the guardian preflight.
#
#   TSUNAGI_PRODUCER_DRYRUN
#   TSUNAGI_FORGE_PREVIEW_ONLY
#   TSUNAGI_FORGE_NO_BROADCAST
#   TSUNAGI_FORGE_POLICY
#   TSUNAGI_FORGE_GATE_ENFORCE
#   TSUNAGI_BCAST_ENABLE
#   TSUNAGI_BCAST_PREVIEW_ONLY
#   TSUNAGI_BCAST_NO_INJECT
#   TSUNAGI_BCAST_REQUIRE_GUARDIAN_CONFIRM
#
# If you are migrating from a pre-#171 forge.env, delete these lines and
# rely on TSUNAGI_MODE + the two FORGE_* gates above.
# ────────────────────────────────────────────────────────────────────────────
